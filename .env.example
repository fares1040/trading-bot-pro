# Market data
FINNHUB_API_KEY=
HUNTER_UNIVERSE=

# Optional live options flow
# Unusual Whales provides real-time options flow when an API plan/key is configured.
UNUSUAL_WHALES_API_KEY=
UNUSUAL_WHALES_API_BASE_URL=https://api.unusualwhales.com/api
UNUSUAL_WHALES_FLOW_PATH=/option-trades/flow-alerts
UNUSUAL_WHALES_FLOW_LIMIT=50

# AI (optional)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Legacy alias (optional) — used as fallback if SUPABASE_SERVICE_ROLE_KEY is unset
# SUPABASE_SERVICE_KEY=

# Telegram / Discord
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
DISCORD_WEBHOOK_URL=
# Cron / app
CRON_SECRET=
NEXT_PUBLIC_BASE_URL=

# Dashboard read token (optional) — browser-facing, low-privilege token for
# read-only dashboard API access. Generate with: openssl rand -hex 24
NEXT_PUBLIC_DASHBOARD_READ_TOKEN=

# FINRA institutional data (optional)
# FINRA ATS/OTC weekly summary data is delayed/aggregated, not real-time.
# On serverless platforms (Vercel, Lambda, etc.), verification state resets
# on cold start. Call /api/finra-verify to verify in each new instance.
# See lib/institutional-provider.js for the in-memory limitation details.
FINRA_API_CLIENT_ID=
FINRA_API_CLIENT_SECRET=

# Phase 8 feature gate
HUNTER_DEFAULT_PLAN=free
